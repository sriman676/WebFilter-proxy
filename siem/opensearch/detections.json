{
  "_comment": "Single source of truth for detections (A-35). Evaluated by scripts/siem/detect.py over JSONL or OpenSearch. Logic, thresholds and tuning: docs/DETECTIONS.md.",
  "detections": [
    {"id": "WF-01", "name": "Top blocked domains", "kind": "report", "window_mins": 1440,
     "match": {"event_type": "request", "action": ["blocked"]}, "group_by": ["dest_host", "rule_id"], "min_count": 1},
    {"id": "WF-02", "name": "Client with high block rate", "kind": "ratio", "window_mins": 60,
     "match": {"event_type": "request"}, "group_by": ["src_ip"],
     "ratio": {"field": "action", "value": "blocked", "min_hits": 10, "min_pct": 30}},
    {"id": "WF-03", "name": "Possible beaconing", "kind": "beacon", "window_mins": 240,
     "match": {"event_type": "request"}, "group_by": ["src_ip", "dest_host"],
     "beacon": {"min_count": 21, "max_jitter": 0.1, "min_interval_secs": 5}},
    {"id": "WF-04", "name": "Suspicious long hostnames (DGA-like)", "kind": "threshold", "window_mins": 1440,
     "match": {"event_type": "request"}, "min_len": {"dest_host": 41}, "group_by": ["dest_host"], "min_count": 1},
    {"id": "WF-05", "name": "Smuggling or malformed request attempts", "kind": "threshold", "window_mins": 60,
     "match": {"event_type": "request", "reason": ["invalid_request", "parser_differential"]}, "group_by": ["src_ip"], "min_count": 5},
    {"id": "WF-06", "name": "SSRF and port abuse attempts", "kind": "threshold", "window_mins": 60,
     "match": {"event_type": "request", "reason": ["private_range", "port_not_allowed", "loop_detected"]}, "group_by": ["src_ip"], "min_count": 3},
    {"id": "WF-07", "name": "Proxy auth failures", "kind": "threshold", "window_mins": 60,
     "match": {"event_type": "request", "reason": ["auth_failed", "rate_limited"]}, "group_by": ["src_ip", "proxy_user"], "min_count": 5},
    {"id": "WF-08", "name": "TLS anomalies", "kind": "threshold", "window_mins": 1440,
     "match": {"event_type": "request", "reason": ["sni_mismatch", "host_mismatch", "upstream_cert_invalid", "non_tls_on_connect"]}, "group_by": ["src_ip", "dest_host", "reason"], "min_count": 1},
    {"id": "WF-09", "name": "Suspicious encoding evasion", "kind": "threshold", "window_mins": 1440,
     "match": {"event_type": "request", "suspicious_encoding": [true]}, "group_by": ["src_ip", "dest_host"], "min_count": 1},
    {"id": "WF-10", "name": "Log pipeline and integrity health", "kind": "threshold", "window_mins": 1440,
     "match": {"event_type": "system", "kind": ["log_dropped", "blocklist_reload_failed", "ca_permission_error", "panic_isolated", "insecure_permissions"]}, "group_by": ["kind"], "min_count": 1},
    {"id": "WF-11", "name": "Rate limited or over-quota clients", "kind": "threshold", "window_mins": 60,
     "match": {"event_type": "request", "reason": ["rate_limited", "quota_exceeded", "too_many_connections"]}, "group_by": ["client_id", "reason"], "min_count": 10},
    {"id": "WF-12", "name": "Malware detections and unscannable downloads", "kind": "threshold", "window_mins": 1440,
     "match": {"event_type": "request", "scan_status": ["infected", "blocklisted", "unscannable", "error"]}, "group_by": ["client_id", "dest_host", "scan_status"], "min_count": 1},
    {"id": "WF-13", "name": "Threat feed hits", "kind": "threshold", "window_mins": 1440,
     "match": {"event_type": "request", "reason": ["feed_domain", "feed_url", "feed_ip"]}, "group_by": ["client_id", "dest_host"], "min_count": 1},
    {"id": "WF-14", "name": "Feed pipeline health", "kind": "threshold", "window_mins": 1440,
     "match": {"event_type": "system", "kind": ["feed_failed", "feed_rejected", "feed_stale"]}, "group_by": ["kind"], "min_count": 1},
    {"id": "WF-15", "name": "Access requests", "kind": "report", "window_mins": 1440,
     "match": {"event_type": "access_request"}, "group_by": ["request_id", "status"], "min_count": 1},
    {"id": "WF-16", "name": "Admin actions and auth failures", "kind": "threshold", "window_mins": 1440,
     "match": {"event_type": "admin", "result": ["denied", "auth_failed"]}, "group_by": ["remote_addr", "action"], "min_count": 3}
  ]
}
